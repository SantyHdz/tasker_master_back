    {
      "parameters": {
        "jsCode": "const task = $input.first().json;\n\nconst task_id = task.id;\nconst notification_type = task.notification_type;\n\nconst dueDate = new Date(task.due_date);\nconst formattedDate = dueDate.toLocaleString('es-CO', {\n  timeZone: 'America/Bogota',\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit'\n});\n\nconst now = new Date();\nconst diffMs = dueDate.getTime() - now.getTime();\nconst diffHours = Math.floor(diffMs / (1000 * 60 * 60));\nconst diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));\n\nlet timeRemaining = '';\nif (diffHours > 0) {\n  timeRemaining = `${diffHours}h ${diffMinutes}m`;\n} else if (diffMinutes > 0) {\n  timeRemaining = `${diffMinutes} minutos`;\n} else {\n  timeRemaining = 'menos de 1 minuto';\n}\n\nconst alertEmojis = { '24h': '📅', '1h': '⚠️', '10m': '🚨' };\nconst alertTitles = {\n  '24h': 'Recordatorio — 24 horas',\n  '1h': '¡Atención\\! — 1 hora restante',\n  '10m': '¡URGENTE\\! — 10 minutos'\n};\n\nconst alertEmoji = alertEmojis[task.notification_type] || '📋';\nconst alertTitle = alertTitles[task.notification_type] || 'Recordatorio';\n\nconst escapeMarkdown = (text) => {\n  if (!text) return '';\n  return String(text).replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\n};\n\nconst titleLine = `${alertEmoji} *${alertTitle}*`;\nconst taskLine = `📌 *Tarea:* ${escapeMarkdown(task.title)}`;\nconst descLine = task.description ? `📝 *Descripción:* ${escapeMarkdown(task.description)}` : null;\nconst priorityLine = `${task.priority_emoji} *Prioridad:* ${escapeMarkdown(task.priority_label)}`;\nconst dateLine = `🕒 *Vence:* ${escapeMarkdown(formattedDate)}`;\nconst timeLine = `⏳ *Tiempo restante:* ${escapeMarkdown(timeRemaining)}`;\nconst footerLine = `_TaskerMaster — Tu asistente de tareas_`;\n\nconst lines = [titleLine, '', taskLine];\nif (descLine) lines.push(descLine);\nlines.push(priorityLine, dateLine, timeLine, '', footerLine);\n\nconst message = lines.join('\\n');\n\nreturn [{\n  json: {\n    ...task,\n    task_id,\n    notification_type,\n    telegram_message: message,\n    formatted_due_date: formattedDate,\n    time_remaining: timeRemaining\n  }\n}];"
      },
