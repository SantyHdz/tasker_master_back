      "id": "6bb3b34c-ffce-472d-8f0e-e64e530ca687",
      "name": "Cron cada 10 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -1200,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nif (!data || (!data['24h'] && !data['1h'] && !data['10m'])) {\n  return [{ json: { empty: true, reason: 'API no respondió correctamente o sin datos' } }];\n}\n\nconst tasks24h = (data['24h'] || []).map(task => ({\n  ...task,\n  notification_type: '24h',\n  notification_label: '24 horas'\n}));\n\nconst tasks1h = (data['1h'] || []).map(task => ({\n  ...task,\n  notification_type: '1h',\n  notification_label: '1 hora'\n}));\n\nconst tasks10m = (data['10m'] || []).map(task => ({\n  ...task,\n  notification_type: '10m',\n  notification_label: '10 minutos'\n}));\n\nconst allTasks = [...tasks24h, ...tasks1h, ...tasks10m];\n\nif (allTasks.length === 0) {\n  return [{ json: { empty: true, reason: 'No hay tareas próximas a vencer' } }];\n}\n\nreturn allTasks.map(task => ({ json: task }));"
      },
